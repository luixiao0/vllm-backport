# Experimental Python overlay; use the normal Dockerfile for a full source build.
ARG BASE_IMAGE=lazymio/vllm-backport:v0.13.1-sm80
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/luixiao0/vllm-backport"
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
LABEL org.opencontainers.image.description="Experimental SM80 candidate-selection overlay; serving validation pending"

COPY vllm/envs.py /tmp/sm80-candidate/envs.py
COPY vllm/model_executor/kernels/attention/dsa/candidate_blocks.py /tmp/sm80-candidate/candidate_blocks.py
COPY vllm/model_executor/kernels/attention/dsa/candidate_radix.py /tmp/sm80-candidate/candidate_radix.py
COPY tools/sm80/install-candidate-overlay.py /tmp/sm80-candidate/install.py
RUN CUDA_VISIBLE_DEVICES="" uv run --no-project python3 /tmp/sm80-candidate/install.py
ENV VLLM_DSV4_LENGTH_AWARE_CANDIDATE_SCORES=0
ENV VLLM_DSV4_CANDIDATE_SELECTION_BACKEND=torch
