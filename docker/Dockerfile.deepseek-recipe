FROM ghcr.io/astral-sh/uv:0.13.1-python3.13-trixie-slim@sha256:7dd72af08bdef012fdf433082190d2b5133a96b6a43aca0bb71c2aa793e47e20

ENV UV_NO_CACHE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/recipe
COPY tools/deepseek-recipe/requirements.txt ./requirements.txt
RUN uv venv /opt/recipe/.venv \
    && uv pip sync --python /opt/recipe/.venv/bin/python --require-hashes \
       --only-binary :all: requirements.txt
COPY tools/deepseek-recipe/gateway.py ./gateway.py
USER 65532:65532
ENTRYPOINT ["/opt/recipe/.venv/bin/python", "-m", "uvicorn", "gateway:create_app", "--factory", "--host", "127.0.0.1", "--port", "18006", "--limit-concurrency", "16", "--no-access-log"]
